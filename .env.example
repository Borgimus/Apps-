# ── Trading Mode ──────────────────────────────────────────────────────────────
# WARNING: Setting LIVE_TRADING_ENABLED=true will place REAL orders with REAL money.
# Leave as false unless you have fully tested your strategies in paper mode.
LIVE_TRADING_ENABLED=false

# ── Active Broker ─────────────────────────────────────────────────────────────
# Options: alpaca | tradier | ibkr
BROKER=alpaca

# ── Alpaca ────────────────────────────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Paper trading base URL (default). Change to https://api.alpaca.markets for live.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Tradier ───────────────────────────────────────────────────────────────────
TRADIER_ACCESS_TOKEN=your_tradier_access_token_here
# Sandbox: https://sandbox.tradier.com/v1  |  Live: https://api.tradier.com/v1
TRADIER_BASE_URL=https://sandbox.tradier.com/v1

# ── Interactive Brokers ───────────────────────────────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
# TWS paper trading port: 7497  |  Live port: 7496

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default): sqlite+aiosqlite:///./trading.db
# Postgres: postgresql+asyncpg://user:password@localhost/trading
DATABASE_URL=sqlite+aiosqlite:///./trading.db

# ── Kill Switch ───────────────────────────────────────────────────────────────
# Create this file to immediately halt all new order placement
KILL_SWITCH_FILE=./KILL_SWITCH

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/trading.log

# ── Dashboard API ─────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ══════════════════════════════════════════════════════════════════════════════
#  TC2000 + Alpaca SWING-TRADING system (PAPER ONLY)  — names & placeholders only
# ══════════════════════════════════════════════════════════════════════════════
# Alpaca PAPER endpoint is enforced in code; the live host is rejected at startup.
SWING_ALPACA_BASE_URL=https://paper-api.alpaca.markets
SWING_ALPACA_KEY_ID=your_paper_key_id_here
SWING_ALPACA_SECRET_KEY=your_paper_secret_here
SWING_ALPACA_DATA_FEED=iex            # iex | sip  (recorded per snapshot)

# Versioned strategy config path and operating mode.
SWING_STRATEGY_CONFIG=./config/strategy.yaml
SWING_MODE=SHADOW                     # BACKTEST | SHADOW | PAPER_CONFIRM | PAPER_AUTO

# Database (Postgres in deployment; SQLite only for local dev/tests).
SWING_DATABASE_URL=postgresql://user:password@localhost:5432/swing

# Dashboard auth (bearer token; fail-closed if unset). Never commit a real token.
SWING_DASHBOARD_TOKEN=your_dashboard_bearer_token_here

# Provider-neutral notifications (names only; never commit real webhooks/tokens).
SWING_NOTIFY_WEBHOOK_URL=

# Optional Windows companion -> trading service (TLS + API key; cannot place orders).
SWING_COMPANION_API_KEY=your_companion_key_here

# Opt-in Alpaca paper sandbox test suite (never runs on forked PRs).
RUN_ALPACA_SANDBOX=0

# ── Live trading loop (opt-in; PAPER ONLY) ──────────────────────────────────
SWING_ENABLE_LOOP=0                 # 1 to run the orchestrator tick loop
SWING_TICK_SECONDS=30
SWING_SETUPS_FILE=./data/live_setups.json
# PAPER_AUTO is refused unless this explicitly attests the acceptance gates are met:
SWING_ACCEPT_PAPER_AUTO=0
